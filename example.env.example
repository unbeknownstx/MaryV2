# MaryV2 Environment

# ============================================================
# FREE-FIRST LLM ROUTING
# ============================================================
# Normal Mary turns try the free routes in this order. Providers whose API
# keys are missing are skipped automatically. Ollama is the local fallback.
MARY_LLM_ROUTING_STRATEGY=free_first
MARY_LLM_FREE_ORDER=groq,gemini,openrouter,ollama
MARY_LLM_RATE_LIMIT_COOLDOWN=300

# The legacy/default provider is retained for explicit/configured routing.
MARY_LLM_PROVIDER=groq
MARY_LLM_MODEL=openai/gpt-oss-20b
MARY_GROQ_MODEL=openai/gpt-oss-20b

# Free cloud provider API keys
GROQ_API_KEY=your_groq_key_here
GEMINI_API_KEY=your_gemini_key_here
OPENROUTER_API_KEY=your_openrouter_key_here

# Keep OpenRouter on zero-cost routing. In free_first mode Mary also protects
# against an accidental paid model here by falling back to openrouter/free.
MARY_OPENROUTER_MODEL=openrouter/free
MARY_GEMINI_MODEL=gemini-2.5-flash

# Local Ollama fallback
MARY_OLLAMA_ENABLED=true
MARY_OLLAMA_MODEL=qwen3:4b-instruct
MARY_OLLAMA_BASE_URL=http://localhost:11434
MARY_OLLAMA_KEEP_ALIVE=30m
MARY_OLLAMA_NUM_CTX=4096
MARY_OLLAMA_THINK=false

# Optional paid provider. free_first never selects it automatically.
# OPENAI_API_KEY=your_openai_key_here

# Web Search
TAVILY_API_KEY=your_tavily_key_here
MARY_SEARCH_PROVIDER=tavily

# Optional alternate search provider
# BRAVE_API_KEY=your_brave_key_here
# MARY_SEARCH_PROVIDER=brave

# Runtime
MARY_ENVIRONMENT=development
MARY_DEBUG=true
MARY_AUTONOMOUS=true

# Desktop Voice (opt-in)
# Use a voice ID you are authorized to use.
MARY_TTS_PROVIDER=off
# ELEVENLABS_API_KEY=your_elevenlabs_key_here
# MARY_ELEVENLABS_VOICE_ID=your_authorized_voice_id_here
# MARY_ELEVENLABS_MODEL=eleven_flash_v2_5
# Calibrated Mary Cosma voice baseline
# MARY_TTS_STABILITY=0.42
# MARY_TTS_SIMILARITY=0.82
# MARY_TTS_STYLE=0.11
# MARY_TTS_SPEED=0.97
# MARY_TTS_SPEAKER_BOOST=true
