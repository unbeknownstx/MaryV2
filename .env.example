# MaryV2 Environment

# ============================================================
# FREE-FIRST LLM ROUTING
# ============================================================
# Ordinary Mary cognition stays inside the zero-cost/free boundary. Local
# engines are candidates first only after real lane-specific measurements show
# they are suitable; otherwise the responsive free-cloud path remains valid.
# Paid/frontier providers are explicit-only and are never injected here.
MARY_LLM_ROUTING_STRATEGY=free_first
MARY_LLM_FREE_ORDER=groq,gemini,openrouter,ollama
# Personal/relationship conversation is independently configurable. Keep this
# stable while local-node acceptance is still in progress; once a local engine
# is measured as suitable, put it first without changing the spending boundary.
MARY_LLM_CONVERSATION_ORDER=local_device,groq,gemini,openrouter,ollama
MARY_LLM_RATE_LIMIT_COOLDOWN=300

# The legacy/default provider is retained for explicit/configured routing.
MARY_LLM_PROVIDER=groq
MARY_LLM_MODEL=openai/gpt-oss-20b
MARY_GROQ_MODEL=openai/gpt-oss-20b
# MARY_GROQ_CONVERSATION_MODEL=openai/gpt-oss-20b  # optional separate fast-chat override

# Free cloud provider API keys
GROQ_API_KEY=your_groq_key_here
GEMINI_API_KEY=your_gemini_key_here
OPENROUTER_API_KEY=your_openrouter_key_here

# Keep OpenRouter on zero-cost routing. In free_first mode Mary also protects
# against an accidental paid model here by falling back to openrouter/free.
MARY_OPENROUTER_MODEL=openrouter/free
MARY_GEMINI_MODEL=gemini-3.6-flash
MARY_GEMINI_TIMEOUT_SECONDS=8

# Local Ollama fallback. Defaults are deliberately conservative for a shared
# display GPU. Stronger nodes opt into larger models/context explicitly.
MARY_OLLAMA_ENABLED=true
MARY_OLLAMA_MODEL=qwen3:1.7b
MARY_OLLAMA_BASE_URL=http://localhost:11434
MARY_OLLAMA_KEEP_ALIVE=10m
MARY_OLLAMA_NUM_CTX=4096
MARY_OLLAMA_THINK=false

# Unified host-local conversation lane. local_device is a logical provider;
# the device chooses the runtime. Auto currently prefers a ready LM Studio
# model, then Ollama, then llama.cpp. No model is downloaded automatically.
MARY_LOCAL_INFERENCE_RUNTIME=auto
# Fast social/conversation turns may prefer a smaller already-installed Ollama
# worker and transparently fall back to LM Studio when Ollama is unavailable.
MARY_LOCAL_FAST_RUNTIME_ORDER=ollama
MARY_OLLAMA_FAST_MODEL=qwen3:1.7b
# Core waits only briefly for the small fast worker; deeper/local conversation
# keeps the normal longer device budget.
MARY_DEVICE_LOCAL_FAST_TIMEOUT=12
MARY_DEVICE_LOCAL_FAST_GENERATION_TIMEOUT=10
MARY_DEVICE_LOCAL_TIMEOUT=180

# Qualified Windows conversation baseline measured on the RX 580 4 GB host.
# LM Studio remains a replaceable runtime; Mary Core continues to own identity,
# memory, relationship, routing policy, and conversation state.
MARY_LM_STUDIO_AUTOSTART=true
MARY_LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
MARY_LM_STUDIO_MODEL=mary-conversation
MARY_LM_STUDIO_IDENTIFIER=mary-conversation
MARY_LM_STUDIO_LOAD_MODEL=qwen/qwen3-4b-2507
MARY_LM_STUDIO_CONTEXT=4096
MARY_LM_STUDIO_GPU=max

# Product-mode desktop startup can host the bounded local capability node so
# opening Mary is enough for normal conversation. Headless run_home_node remains
# available for always-on/mobile use. This permission authorizes only llm.local;
# it does not grant filesystem, shell, MCP, sensor, or tool execution.
MARY_DESKTOP_LOCAL_COMPUTE=true
MARY_DESKTOP_LOCAL_COMPUTE_AUTO_AUTHORIZE=true

# Constrained Windows/Polaris nodes should use the explicit launcher profile
# instead of changing global defaults:
# python -m scripts.run_home_node --hardware-profile windows-rx580-4gb
# Explicit private/local fast conversation compiles a small worker prompt rather
# than sending Mary's entire canonical context to a small resident model.
MARY_LOCAL_FAST_CONTEXT_CHARS=5000
MARY_LOCAL_FAST_MAX_TOKENS=96
# Remote capability-node local inference may expand context dynamically up to this ceiling.
MARY_DEVICE_OLLAMA_MAX_CTX=4096
MARY_DEVICE_OLLAMA_GENERATION_TIMEOUT=420
MARY_DEVICE_OLLAMA_TIMEOUT=480
# Python creator surfaces may wait longer when a local node is doing the work.
MARY_CORE_CLIENT_TIMEOUT=600

# Optional paid provider. free_first never selects it automatically.
# OPENAI_API_KEY=your_openai_key_here
# MARY_OPENAI_MODEL=gpt-5.6-luna

# ============================================================
# MARYV2 13.15 — FRONTIER / OPEN MODEL FABRIC (OPTIONAL)
# ============================================================
# These direct cloud routes are opt-in. Merely adding a key does NOT add them
# to free_first or ordinary companion conversation. Use route=frontier,
# route=expert with MARY_LLM_EXPERT_PROVIDER, or an explicit provider request.
# MARY_LLM_FRONTIER_ORDER=deepseek,zai,qwen_cloud,kimi,minimax,cerebras,together,fireworks,openai
# Explicit frontier/reasoning/specialist calls get a larger bounded output
# budget than ordinary chat. Token usage remains process-local telemetry.
MARY_FRONTIER_MAX_OUTPUT_TOKENS=8192
#
# DeepSeek
# DEEPSEEK_API_KEY=
# MARY_DEEPSEEK_MODEL=deepseek-flash
# MARY_DEEPSEEK_BASE_URL=https://api.deepseek.com
#
# Z.AI / GLM
# ZAI_API_KEY=
# MARY_ZAI_MODEL=glm-5.3-flash
# MARY_ZAI_BASE_URL=https://api.z.ai/api/paas/v4/
#
# Alibaba Cloud / Qwen. The default preset uses the US compatible endpoint;
# override the base URL for another Model Studio region/workspace.
# QWEN_API_KEY=
# DASHSCOPE_API_KEY=
# MARY_QWEN_CLOUD_MODEL=qwen3.8-flash
# MARY_QWEN_CLOUD_BASE_URL=https://dashscope-us.aliyuncs.com/compatible-mode/v1
#
# Moonshot / Kimi
# MOONSHOT_API_KEY=
# KIMI_API_KEY=
# MARY_KIMI_MODEL=kimi-k3
# MARY_KIMI_BASE_URL=https://api.moonshot.ai/v1
#
# MiniMax
# MINIMAX_API_KEY=
# MARY_MINIMAX_MODEL=MiniMax-M3
# MARY_MINIMAX_BASE_URL=https://api.minimax.io/v1
#
# Hosted open-model inference
# CEREBRAS_API_KEY=
# MARY_CEREBRAS_MODEL=gpt-oss-120b
# TOGETHER_API_KEY=
# MARY_TOGETHER_MODEL=openai/gpt-oss-120b
# FIREWORKS_API_KEY=
# MARY_FIREWORKS_MODEL=accounts/fireworks/models/deepseek-v3p1
#
# Future-provider / local-server escape hatch. Loopback endpoints can operate
# without a key and are advertised as local-only/zero-local; remote endpoints
# require a key and remain explicit paid-capable routes.
# MARY_OPENAI_COMPAT_BASE_URL=http://127.0.0.1:9000/v1
# MARY_OPENAI_COMPAT_MODEL=
# MARY_OPENAI_COMPAT_API_KEY=

# Web Search
TAVILY_API_KEY=your_tavily_key_here
MARY_SEARCH_PROVIDER=tavily

# Optional alternate search provider
# BRAVE_API_KEY=your_brave_key_here
# MARY_SEARCH_PROVIDER=brave

# Runtime
MARY_ENVIRONMENT=development
MARY_DEBUG=true
MARY_AUTONOMOUS=true
MARY_CONVERSATION_MODE=adaptive  # adaptive | quick | engaged | deep

# Desktop Voice (opt-in)
# Use a voice ID you are authorized to use.
# Voice is a separate budget lane from LLM routing. ElevenLabs may be the
# intentional paid exception during voice/stream testing while ordinary LLM
# cognition remains local/free-first.
MARY_TTS_PROVIDER=auto_fast
# auto_fast prefers configured ElevenLabs Flash, then falls back to local Piper/SAPI.
# ELEVENLABS_API_KEY=your_elevenlabs_key_here
# MARY_ELEVENLABS_VOICE_ID=your_authorized_voice_id_here
# MARY_ELEVENLABS_MODEL=eleven_flash_v2_5
# Calibrated Mary Cosma voice baseline
# MARY_TTS_STABILITY=0.50
# MARY_TTS_SIMILARITY=0.75
# MARY_TTS_STYLE=0.0
# MARY_TTS_SPEED=1.0
# MARY_TTS_SPEAKER_BOOST=false
# MARY_TTS_ALIGNMENT=false  # ElevenLabs only: precise character timing for avatar/captions; opt-in because response is JSON/base64
# MARY_TTS_DYNAMIC_DELIVERY=false  # natural baseline by default; enable after Voice Lab tuning

# ============================================================
# DESKTOP CREATIVE APP INTEGRATIONS (OPTIONAL)
# ============================================================
# Set only the applications you want Mary Desktop to expose. The bridge has a
# finite allowlist and never accepts arbitrary shell commands from the UI.
# MARY_PHOTOSHOP_PATH=C:\Program Files\Adobe\Adobe Photoshop 2026\Photoshop.exe
# MARY_CLIP_STUDIO_PATH=C:\Program Files\CELSYS\CLIP STUDIO 1.5\CLIP STUDIO PAINT\CLIPStudioPaint.exe
# MARY_KRITA_PATH=C:\Program Files\Krita (x64)\bin\krita.exe
# MARY_BLENDER_PATH=C:\Program Files\Blender Foundation\Blender 4.5\blender.exe
# MARY_DAVINCI_PATH=C:\Program Files\Blackmagic Design\DaVinci Resolve\Resolve.exe
# MARY_AUDACITY_PATH=C:\Program Files\Audacity\Audacity.exe

# ============================================================
# GAME LAUNCHER / UPDATES (OPTIONAL)
# ============================================================
# Leave blank for a private/manual install. Later this can point at a small
# HTTPS JSON manifest from a private GitHub release or another server.
# MARY_UPDATE_MANIFEST_URL=https://example.com/mary/latest.json

# ============================================================
# MARYV2 12.10 — LOCAL VOICE / PRESENCE / SKILLS
# ============================================================
# Recommended first-PC setting. Uses Piper when configured, otherwise Windows
# SAPI locally. ElevenLabs is only used if cloud fallback is explicitly enabled.
MARY_TTS_ALLOW_CLOUD_FALLBACK=false
# Optional local Piper install:
# MARY_PIPER_EXECUTABLE=C:\MaryTools\piper\piper.exe
# MARY_PIPER_MODEL=C:\MaryTools\piper\mary.onnx
# Optional higher-quality local GPT-SoVITS renderer.
# Run the official GPT-SoVITS api_v2.py on loopback; Mary will not accept a
# remote host for this adapter. The reference audio path is interpreted by the
# local GPT-SoVITS process.
# MARY_GPT_SOVITS_ENABLED=false
# MARY_GPT_SOVITS_URL=http://127.0.0.1:9880
# MARY_GPT_SOVITS_REF_AUDIO=C:\MaryTools\GPT-SoVITS\references\mary.wav
# MARY_GPT_SOVITS_PROMPT_TEXT=
# MARY_GPT_SOVITS_TEXT_LANG=en
# MARY_GPT_SOVITS_PROMPT_LANG=en
# MARY_GPT_SOVITS_VOICE_LABEL=Mary local
# MARY_GPT_SOVITS_TIMEOUT=45
# To select it directly instead of local_first:
# MARY_TTS_PROVIDER=gpt_sovits
# Optional Windows voice name (leave blank to use the Windows default voice):
# MARY_WINDOWS_TTS_VOICE=

# Mobile voice transport (optional tuning; safe defaults are built in)
# The phone never receives ELEVENLABS_API_KEY or any provider credential.
# Native iOS uses authenticated /v1/voice/status + /v1/voice/synthesize on Core.
# MARY_MOBILE_TTS_MAX_CHARS=4000
# MARY_MOBILE_TTS_CACHE_ITEMS=12
# MARY_MOBILE_TTS_CACHE_BYTES=24000000
# MARY_MOBILE_STT_MAX_BYTES=12000000
# Optional fixed mobile bearer token. If omitted, Mary creates one under
# data/mobile/access_token.txt on non-loopback hosts such as Replit.
# MARY_MOBILE_TOKEN=use-a-long-random-secret
# For a separately hosted frontend, comma-separate explicitly allowed origins.
# MARY_MOBILE_ALLOWED_ORIGINS=https://mary.example.com

# Speech recognition: keep Groq for first boot, or install faster-whisper later.
MARY_STT_PROVIDER=groq
# MARY_STT_PROVIDER=local_first
# MARY_STT_MODEL=small.en
# MARY_STT_DEVICE=auto
# MARY_STT_COMPUTE_TYPE=int8

# Presence is local and safe by default. External skills remain disabled.
MARY_PRESENCE_MODE=companion
MARY_PRESENCE_MIN_SPEAK_INTERVAL=35
MARY_PRESENCE_THRESHOLD=0.72
MARY_VISUAL_CONTEXT=off
MARY_SKILL_TWITCH=false
MARY_SKILL_OBS=false
MARY_SKILL_VISION=false
MARY_SKILL_RENPY=false
MARY_SKILL_EXPERT=false

# Windowed-mode quality of life
MARY_DESKTOP_REMEMBER_WINDOW=true

# MaryV2 12.11 connected presence / media
# Local WebSocket transport is disabled by default and binds loopback only.
MARY_WEBSOCKET_ENABLED=false
MARY_WEBSOCKET_HOST=127.0.0.1
MARY_WEBSOCKET_PORT=8765
MARY_WEBSOCKET_TOKEN=

# Explicit YouTube Data API search. No autonomous browsing; no arbitrary transcript scraping.
MARY_YOUTUBE_ENABLED=false
YOUTUBE_API_KEY=
MARY_YOUTUBE_MAX_RESULTS=6

# Built-in ambient bed. Speech automatically ducks it.
MARY_AMBIENT_MUSIC_ENABLED=true
MARY_AMBIENT_MUSIC_VOLUME=0.08

# ============================================================
# MARYV2 12.12 — LOCAL CHARACTER MIND / COGNITIVE RESERVOIR
# ============================================================
# These are local deterministic systems. They do not replace canonical Mary
# identity/memory/relationship state and do not require an LLM to start.
MARY_LOCAL_MIND_ENABLED=true
MARY_LOCAL_DIALOGUE_ENABLED=true
MARY_RESERVOIR_MAX_RECORDS=50000
MARY_RESERVOIR_MAX_MB=512

# Optional purpose-specific Ollama roles. Leave these unset until the models
# are actually installed and benchmarked on the current PC.
# MARY_OLLAMA_CONVERSATION_MODEL=qwen3:1.7b
# MARY_OLLAMA_UTILITY_MODEL=gemma3:1b
# MARY_OLLAMA_REASONING_MODEL=phi4-mini
# MARY_OLLAMA_EMBED_MODEL=nomic-embed-text

# ============================================================
# MARYV2 13.1 — REALTIME / HYBRID RETRIEVAL / COMPUTE NODES
# ============================================================
# Vector search is a derived retrieval aid, never Mary's source of truth.
# auto = remain lexical-only until you explicitly build a local vector index.
MARY_VECTOR_RETRIEVAL=auto
MARY_VECTOR_INDEX_LIMIT=1000
MARY_VECTOR_MAX_SCAN=5000
MARY_RETRIEVAL_LEXICAL_WEIGHT=0.62
MARY_RETRIEVAL_VECTOR_WEIGHT=0.38
# Embeddings stay local through Ollama in 13.1. Install explicitly only when wanted:
# ollama pull nomic-embed-text
# MARY_OLLAMA_EMBED_MODEL=nomic-embed-text

# Optional stable label for this runtime in Mary's compute-node registry.
# Future cloud/home-node transport will use the same capability contract.
# MARY_NODE_ID=home-pc

# ============================================================
# MARYV2 13.2 — UNIFIED AUTHORITATIVE CORE
# ============================================================
# Mary Core is the single runtime/state authority used by remote clients.
# Core deployment/server:
# MARY_CORE_TOKEN=replace-with-a-long-random-creator-token
MARY_CORE_HOST=127.0.0.1
# Client/Replit/Desktop remote mode:
# MARY_CORE_URL=https://your-mary-core.example
# MARY_CORE_TOKEN=the-same-private-core-token
# MARY_DEVICE_ID=replit-mobile
# Headless/capability-node mode uses a creator-issued, node-ID-bound grant
# instead of retaining creator access. Core stores only its digest and audit data.
# MARY_NODE_ID=home-pc
# MARY_NODE_ENROLLMENT_GRANT=creator-issued-scoped-grant
# Default short-dialogue thread. The web client can switch between bounded
# conversation IDs without creating another Mary or another durable identity.
MARY_CONVERSATION_ID=creator-primary
# MARY_CORE_PORT=8080
# Railway/container deployment with a persistent volume:
# MARY_CORE_HOST=0.0.0.0
# MARY_DATA_DIR=/data
# Loopback-only development escape hatch. Never enable on public binds.
# MARY_CORE_ALLOW_INSECURE_LOCAL=false

# ============================================================
# MARYV2 CONVERGENCE — AUTHORED CHARACTER / EVALUATION / CREATIVE SERVICES
# ============================================================
# Optional semicolon-separated Character Bible/corpus/canon sources. DOCX is
# read directly; static Character Core remains the bootstrap when unset.
# MARY_CHARACTER_SOURCES=C:\MarySources\Mary_Definitive_Character_Bible.docx;C:\MarySources\Mary_Corpus.md
# Optional Mary-specific acceptance/evaluation JSON or JSONL file.
# MARY_CHARACTER_EVALS=C:\MarySources\mary_evaluation.json
# Optional secret-free JSON catalog describing external image/video/audio
# capabilities and price hints. API credentials remain in their provider-specific
# private variables and are never stored in this catalog.
# MARY_CREATIVE_SERVICE_CATALOG=C:\MarySources\creative_services.json

# ============================================================
# PROFESSIONAL SOURCE / STATE SEPARATION
# ============================================================
# Normally leave MARY_DATA_DIR unset. Source/development Mary now writes mutable
# state to the host-native MaryV2 application-data directory instead of repo/data.
# Set only when intentionally choosing another persistent volume/location.
# MARY_DATA_DIR=C:\MaryState
# Creator project workspace exposed by local Desktop/Studio when desired.
# MARY_CREATIVE_WORKSPACE=C:\Users\you\Documents\GitHub\MaryV2\projects
# Approved character sources under character_sources/active are auto-discovered;
# use this only for additional external source files/directories.
# MARY_CHARACTER_SOURCES=C:\MarySources\Mary_Corpus.md
# Headless Windows node may start `ollama serve` if Ollama is installed but the
# local endpoint is not already responding. Set false to manage Ollama yourself.
MARY_NODE_START_OLLAMA=true

# ================================================================
# COGNITIVE CHARACTER RUNTIME / REALTIME EXPERIMENTS (OPTIONAL)
# ================================================================
# Large model weights are local runtime assets, never source-controlled Mary state.
# Defaults:
#   macOS:   ~/Library/Application Support/MaryV2/models
#   Windows: %LOCALAPPDATA%\MaryV2\models
#   Linux:   $XDG_DATA_HOME/MaryV2/models (or ~/.local/share/MaryV2/models)
# Override only when you intentionally want another local model disk/cache root.
# MARY_MODEL_DIR=/Volumes/Models/MaryV2

# Apple-Silicon-friendly local STT option. Build/install whisper.cpp separately
# and point Mary at its CLI + GGML model. Groq remains a perfectly valid cloud
# STT choice and no model is downloaded automatically.
# MARY_STT_PROVIDER=whisper_cpp
# MARY_WHISPER_CPP_EXECUTABLE=/opt/homebrew/bin/whisper-cli
# MARY_WHISPER_CPP_MODEL=/Users/you/models/whisper/ggml-base.en.bin
# Optional desktop microphone selector. Leave unset to follow the OS default input.
# MARY_AUDIO_INPUT_DEVICE=MacBook Air Microphone
# Resident Hearing is OFF on startup and only begins after an explicit UI toggle.
# MARY_RESIDENT_VAD_START_MULTIPLIER=3.2
# MARY_RESIDENT_VAD_MIN_START_RMS=350

# Optional lightweight continuous-voice assets. Explicit downloader only:
# python -m scripts.fetch_optional_realtime_assets --silero-vad
# MARY_SILERO_VAD_MODEL=/Users/you/Library/Application Support/MaryV2/models/vad/silero_vad.onnx

# Character runtime behavior remains conservative by default. Streaming chat
# is untrusted environment context and never gains creator/tool authority.
# MARY_FAST_BRAIN_PROVIDER=deterministic
# MARY_FAST_BRAIN_PROVIDER=llama_cpp  # late-binds to a connected local/device llama.cpp route
# MARY_STREAM_CHAT_ENABLED=false

# ---------------------------------------------------------------------------
# OPTIONAL LOCAL LLAMA.CPP / ADAPTER LAB
# ---------------------------------------------------------------------------
# Disabled by default.  Start a local OpenAI-compatible llama.cpp server on a
# Mac/PC, then explicitly select provider=llama_cpp or add it to a chosen route.
MARY_LLAMA_CPP_ENABLED=false
MARY_LLAMA_CPP_BASE_URL=http://127.0.0.1:8080
# Remote canonical Core: register a connected capability-node llama.cpp provider.
# MARY_DEVICE_LLAMA_CPP_ENABLED=true
# Optional routing examples (defaults remain Groq/Gemini/OpenRouter/Ollama):
# MARY_LLM_FREE_ORDER=groq,llama_cpp,gemini,openrouter,ollama
# MARY_LLM_CONVERSATION_ORDER=groq,gemini,openrouter,llama_cpp,ollama
# MARY_LLAMA_CPP_MODEL=
MARY_LLAMA_CPP_TIMEOUT=120
MARY_LLAMA_CPP_HEALTH_TIMEOUT=0.8
MARY_LLAMA_CPP_HEALTH_TTL=5.0
# llama.cpp server LoRA adapters are numbered in load order. Example:
# MARY_LLAMA_CPP_LORA_SCALES=[{"id":0,"scale":0.35}]

# -----------------------------------------------------------------------------
# Optional streaming adapters (node-side; disabled by default)
# -----------------------------------------------------------------------------
# MARY_SKILL_TWITCH=0
# MARY_TWITCH_CLIENT_ID=
# MARY_TWITCH_OAUTH_TOKEN=
# MARY_TWITCH_BROADCASTER_ID=
# MARY_TWITCH_USER_ID=
# MARY_TWITCH_APPROVED_CHANNELS=
# MARY_TWITCH_MODE=listen
# MARY_SKILL_OBS=0
# MARY_OBS_HOST=127.0.0.1
# MARY_OBS_PORT=4455
# MARY_OBS_PASSWORD=
