# MaryV2 Environment

# ============================================================
# FREE-FIRST LLM ROUTING
# ============================================================
# Normal Mary turns try the free routes in this order. Providers whose API
# keys are missing are skipped automatically. Ollama is the local fallback.
MARY_LLM_ROUTING_STRATEGY=free_first
MARY_LLM_FREE_ORDER=groq,gemini,openrouter,ollama
# Personal/relationship conversation is independently configurable. The current
# Windows performance profile prefers free cloud latency first while keeping
# Ollama as the final fallback. Put ollama first for a private/local-first profile.
MARY_LLM_CONVERSATION_ORDER=groq,gemini,openrouter,ollama
MARY_LLM_RATE_LIMIT_COOLDOWN=300

# The legacy/default provider is retained for explicit/configured routing.
MARY_LLM_PROVIDER=groq
MARY_LLM_MODEL=openai/gpt-oss-20b
MARY_GROQ_MODEL=openai/gpt-oss-20b
# MARY_GROQ_CONVERSATION_MODEL=openai/gpt-oss-20b  # optional separate fast-chat override

# Free cloud provider API keys
GROQ_API_KEY=your_groq_key_here
GEMINI_API_KEY=your_gemini_key_here
OPENROUTER_API_KEY=your_openrouter_key_here

# Keep OpenRouter on zero-cost routing. In free_first mode Mary also protects
# against an accidental paid model here by falling back to openrouter/free.
MARY_OPENROUTER_MODEL=openrouter/free
MARY_GEMINI_MODEL=gemini-3.6-flash

# Local Ollama fallback
MARY_OLLAMA_ENABLED=true
MARY_OLLAMA_MODEL=qwen3:4b-instruct
MARY_OLLAMA_BASE_URL=http://localhost:11434
MARY_OLLAMA_KEEP_ALIVE=30m
MARY_OLLAMA_NUM_CTX=4096
MARY_OLLAMA_THINK=false

# Optional paid provider. free_first never selects it automatically.
# OPENAI_API_KEY=your_openai_key_here
# MARY_OPENAI_MODEL=gpt-5.6-luna

# Web Search
TAVILY_API_KEY=your_tavily_key_here
MARY_SEARCH_PROVIDER=tavily

# Optional alternate search provider
# BRAVE_API_KEY=your_brave_key_here
# MARY_SEARCH_PROVIDER=brave

# Runtime
MARY_ENVIRONMENT=development
MARY_DEBUG=true
MARY_AUTONOMOUS=true
MARY_CONVERSATION_MODE=adaptive  # adaptive | quick | engaged | deep

# Desktop Voice (opt-in)
# Use a voice ID you are authorized to use.
# Legacy cloud-only mode is still supported, but 12.10 keeps local_first voice as the recommended zero-spend default.
MARY_TTS_PROVIDER=auto_fast
# auto_fast prefers configured ElevenLabs Flash, then falls back to local Piper/SAPI.
# ELEVENLABS_API_KEY=your_elevenlabs_key_here
# MARY_ELEVENLABS_VOICE_ID=your_authorized_voice_id_here
# MARY_ELEVENLABS_MODEL=eleven_flash_v2_5
# Calibrated Mary Cosma voice baseline
# MARY_TTS_STABILITY=0.50
# MARY_TTS_SIMILARITY=0.75
# MARY_TTS_STYLE=0.0
# MARY_TTS_SPEED=1.0
# MARY_TTS_SPEAKER_BOOST=false
# MARY_TTS_DYNAMIC_DELIVERY=false  # natural baseline by default; enable after Voice Lab tuning

# ============================================================
# DESKTOP CREATIVE APP INTEGRATIONS (OPTIONAL)
# ============================================================
# Set only the applications you want Mary Desktop to expose. The bridge has a
# finite allowlist and never accepts arbitrary shell commands from the UI.
# MARY_PHOTOSHOP_PATH=C:\Program Files\Adobe\Adobe Photoshop 2026\Photoshop.exe
# MARY_CLIP_STUDIO_PATH=C:\Program Files\CELSYS\CLIP STUDIO 1.5\CLIP STUDIO PAINT\CLIPStudioPaint.exe
# MARY_KRITA_PATH=C:\Program Files\Krita (x64)\bin\krita.exe
# MARY_BLENDER_PATH=C:\Program Files\Blender Foundation\Blender 4.5\blender.exe
# MARY_DAVINCI_PATH=C:\Program Files\Blackmagic Design\DaVinci Resolve\Resolve.exe
# MARY_AUDACITY_PATH=C:\Program Files\Audacity\Audacity.exe

# ============================================================
# GAME LAUNCHER / UPDATES (OPTIONAL)
# ============================================================
# Leave blank for a private/manual install. Later this can point at a small
# HTTPS JSON manifest from a private GitHub release or another server.
# MARY_UPDATE_MANIFEST_URL=https://example.com/mary/latest.json

# ============================================================
# MARYV2 12.10 — LOCAL VOICE / PRESENCE / SKILLS
# ============================================================
# Recommended first-PC setting. Uses Piper when configured, otherwise Windows
# SAPI locally. ElevenLabs is only used if cloud fallback is explicitly enabled.
MARY_TTS_ALLOW_CLOUD_FALLBACK=false
# Optional local Piper install:
# MARY_PIPER_EXECUTABLE=C:\MaryTools\piper\piper.exe
# MARY_PIPER_MODEL=C:\MaryTools\piper\mary.onnx
# Optional Windows voice name (leave blank to use the Windows default voice):
# MARY_WINDOWS_TTS_VOICE=

# Mobile voice transport (optional tuning; safe defaults are built in)
# The phone never receives ELEVENLABS_API_KEY or any provider credential.
# MARY_MOBILE_TTS_MAX_CHARS=4000
# MARY_MOBILE_TTS_CACHE_ITEMS=12
# MARY_MOBILE_TTS_CACHE_BYTES=24000000
# MARY_MOBILE_STT_MAX_BYTES=12000000
# Optional fixed mobile bearer token. If omitted, Mary creates one under
# data/mobile/access_token.txt on non-loopback hosts such as Replit.
# MARY_MOBILE_TOKEN=use-a-long-random-secret
# For a separately hosted frontend, comma-separate explicitly allowed origins.
# MARY_MOBILE_ALLOWED_ORIGINS=https://mary.example.com

# Speech recognition: keep Groq for first boot, or install faster-whisper later.
MARY_STT_PROVIDER=groq
# MARY_STT_PROVIDER=local_first
# MARY_STT_MODEL=small.en
# MARY_STT_DEVICE=auto
# MARY_STT_COMPUTE_TYPE=int8

# Presence is local and safe by default. External skills remain disabled.
MARY_PRESENCE_MODE=companion
MARY_PRESENCE_MIN_SPEAK_INTERVAL=35
MARY_PRESENCE_THRESHOLD=0.72
MARY_VISUAL_CONTEXT=off
MARY_SKILL_TWITCH=false
MARY_SKILL_OBS=false
MARY_SKILL_VISION=false
MARY_SKILL_RENPY=false
MARY_SKILL_EXPERT=false

# Windowed-mode quality of life
MARY_DESKTOP_REMEMBER_WINDOW=true

# MaryV2 12.11 connected presence / media
# Local WebSocket transport is disabled by default and binds loopback only.
MARY_WEBSOCKET_ENABLED=false
MARY_WEBSOCKET_HOST=127.0.0.1
MARY_WEBSOCKET_PORT=8765
MARY_WEBSOCKET_TOKEN=

# Explicit YouTube Data API search. No autonomous browsing; no arbitrary transcript scraping.
MARY_YOUTUBE_ENABLED=false
YOUTUBE_API_KEY=
MARY_YOUTUBE_MAX_RESULTS=6

# Built-in ambient bed. Speech automatically ducks it.
MARY_AMBIENT_MUSIC_ENABLED=true
MARY_AMBIENT_MUSIC_VOLUME=0.08

# ============================================================
# MARYV2 12.12 — LOCAL CHARACTER MIND / COGNITIVE RESERVOIR
# ============================================================
# These are local deterministic systems. They do not replace canonical Mary
# identity/memory/relationship state and do not require an LLM to start.
MARY_LOCAL_MIND_ENABLED=true
MARY_LOCAL_DIALOGUE_ENABLED=true
MARY_RESERVOIR_MAX_RECORDS=50000
MARY_RESERVOIR_MAX_MB=512

# Optional purpose-specific Ollama roles. Leave these unset until the models
# are actually installed and benchmarked on the current PC.
# MARY_OLLAMA_CONVERSATION_MODEL=qwen3:1.7b
# MARY_OLLAMA_UTILITY_MODEL=gemma3:1b
# MARY_OLLAMA_REASONING_MODEL=phi4-mini
# MARY_OLLAMA_EMBED_MODEL=nomic-embed-text

# ============================================================
# MARYV2 13.1 — REALTIME / HYBRID RETRIEVAL / COMPUTE NODES
# ============================================================
# Vector search is a derived retrieval aid, never Mary's source of truth.
# auto = remain lexical-only until you explicitly build a local vector index.
MARY_VECTOR_RETRIEVAL=auto
MARY_VECTOR_INDEX_LIMIT=1000
MARY_VECTOR_MAX_SCAN=5000
MARY_RETRIEVAL_LEXICAL_WEIGHT=0.62
MARY_RETRIEVAL_VECTOR_WEIGHT=0.38
# Embeddings stay local through Ollama in 13.1. Install explicitly only when wanted:
# ollama pull nomic-embed-text
# MARY_OLLAMA_EMBED_MODEL=nomic-embed-text

# Optional stable label for this runtime in Mary's compute-node registry.
# Future cloud/home-node transport will use the same capability contract.
# MARY_NODE_ID=home-pc

# ============================================================
# MARYV2 13.2 — UNIFIED AUTHORITATIVE CORE
# ============================================================
# Mary Core is the single runtime/state authority used by remote clients.
# Core deployment/server:
# MARY_CORE_TOKEN=replace-with-a-long-random-creator-token
MARY_CORE_HOST=127.0.0.1
# Client/Replit/Desktop remote mode:
# MARY_CORE_URL=https://your-mary-core.example
# MARY_CORE_TOKEN=the-same-private-core-token
# MARY_DEVICE_ID=replit-mobile
# Default short-dialogue thread. The web client can switch between bounded
# conversation IDs without creating another Mary or another durable identity.
MARY_CONVERSATION_ID=creator-primary
# MARY_CORE_PORT=8080
# Railway/container deployment with a persistent volume:
# MARY_CORE_HOST=0.0.0.0
# MARY_DATA_DIR=/data
# Loopback-only development escape hatch. Never enable on public binds.
# MARY_CORE_ALLOW_INSECURE_LOCAL=false
