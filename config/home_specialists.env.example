# MaryV2 13.14 optional home specialist configuration
# Copy only the settings you explicitly want into the local machine's .env.
# None of these services are Mary Core startup dependencies.

# -----------------------------------------------------------------------------
# STT candidates — choose one MARY_STT_PROVIDER per node after benchmarking.
# -----------------------------------------------------------------------------
# Existing choices remain valid:
# MARY_STT_PROVIDER=groq
# MARY_STT_PROVIDER=faster_whisper
# MARY_STT_PROVIDER=whisper_cpp

# Qwen3-ASR behind a local/audited HTTP bridge:
# MARY_STT_PROVIDER=qwen3_asr
# MARY_QWEN_ASR_ENDPOINT=http://127.0.0.1:9010/transcribe
# MARY_STT_MODEL=qwen3-asr

# FluidAudio bridge, useful candidate for Apple hardware:
# MARY_STT_PROVIDER=fluid_audio
# MARY_FLUID_AUDIO_ENDPOINT=http://127.0.0.1:9020/transcribe
# MARY_STT_MODEL=fluid-audio

# Generic audited specialist STT service:
# MARY_STT_PROVIDER=specialist_http
# MARY_STT_ENDPOINT=https://trusted-stt.example/transcribe

# -----------------------------------------------------------------------------
# Semantic screen perception — choose one after benchmarking.
# -----------------------------------------------------------------------------
# llama.cpp multimodal (libmtmd/OpenAI-compatible chat endpoint):
# MARY_VISION_PROVIDER=llama_cpp_mtmd
# MARY_LLAMA_CPP_VLM_URL=http://127.0.0.1:8081

# OmniParser-style bounded screenshot semantics bridge:
# MARY_VISION_PROVIDER=omniparser
# MARY_OMNIPARSER_ENDPOINT=http://127.0.0.1:9030/parse

# -----------------------------------------------------------------------------
# Presentation research candidates — catalog/readiness only until benchmarked.
# -----------------------------------------------------------------------------
# MARY_CHATTERBOX_ENDPOINT=http://127.0.0.1:9040/synthesize

# -----------------------------------------------------------------------------
# Public stream creator voice — explicit opt-in.
# -----------------------------------------------------------------------------
# MARY_STREAM_CREATOR_HEARING=1
# MARY_STREAM_CONVERSATION_ID=stream-public
# MARY_STREAM_VOICE_RELAY_PORT=8766
# MARY_STREAM_LANGUAGE=en

# -----------------------------------------------------------------------------
# Local device permission gates.
# These are intentionally NOT environment toggles. Use Mary's local permission
# tool/CLI so the node stores an explicit durable opt-in under ~/.maryv2.
# At minimum, authorize only the sensors you intend to use:
#   sensor.audio_transcribe
#   sensor.screen_capture
#   sensor.screen_describe
#
# Run `python -m scripts.check_specialist_backends` and
# `python -m scripts.platform_readiness` before promoting any candidate.
# Benchmark results should decide node placement; configuration presence alone
# is never treated as proof of performance or permission.
