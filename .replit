modules = ["python-3.11"]

[nix]
channel = "stable-25_05"
packages = ["python311Packages.pytest_7", "picolisp"]

[agent]
expertMode = true

[workflows]
runButton = "Mary Mobile"

[[workflows.workflow]]
name = "Mary Mobile"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python -m scripts.run_mobile"

[[workflows.workflow]]
name = "Terminal Mary"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python -m scripts.run_mary"

[[workflows.workflow]]
name = "Check Mobile Voice"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python -m scripts.check_mobile_voice"

[[ports]]
localPort = 8080
externalPort = 80
