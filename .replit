modules = ["python-3.11"]

[nix]
channel = "stable-25_05"
packages = ["python311Packages.pytest_7", "picolisp"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = ".venv/bin/python run_mary.py"

[workflows.workflow.metadata]
outputType = "console"